INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T11', '鼻が詰まっていても鼻呼吸を練習するの？', '鼻づまりなどで鼻呼吸がしにくいときは、無理に鼻呼吸だけを続けようとしません。教材では鼻の通りやいびきなどを確認し、必要な相談につなぐ方針です。自己判断で口閉じテープをすすめる手順も案内しません。', '鼻呼吸の強制や口閉じテープの手順を追加しない。', ARRAY['K082']::text[], ARRAY['P208','P209','P196']::text[], ARRAY['S004']::text[], '[{"passage_id":"P208","chapter":8,"label":"8-3 鼻呼吸と睡眠","asset_id":"BM-CH08-A015","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH08-A015.png"},{"passage_id":"P209","chapter":8,"label":"8-4 口呼吸と睡眠","asset_id":"BM-CH08-A016","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH08-A016.png"},{"passage_id":"P196","chapter":7,"label":"7-5 鼻呼吸と脳","asset_id":"BM-CH07-A014","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH07-A014.png"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T12', '疲れるのはATP不足だから？', '教材にはATPや酸素と体の働きの関係が出てきますが、疲れているということだけでATP不足や低酸素と決めることはできません。一般的な仕組みの説明と、本人の疲れの原因の判断は分けて考えます。', '症状から原因を断定しない。', ARRAY['K070']::text[], ARRAY['P159','P172','P211']::text[], ARRAY['S004']::text[], '[{"passage_id":"P159","chapter":4,"label":"P29 酸素不足","asset_id":"BM-CH04-A002","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH04-A002.png"},{"passage_id":"P172","chapter":5,"label":"P39 エネルギー不足の連鎖","asset_id":"BM-CH05-A010","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH05-A010.jpeg"},{"passage_id":"P211","chapter":8,"label":"8-7 酸素不足と睡眠","asset_id":"BM-CH08-A019","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH08-A019.png"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T13', 'NREM睡眠は4段階？', '第5版の説明では、NREM睡眠をN1・N2・N3の3段階に整理しています。元の図の4段階表示は、保存済みのNHLBI資料との照合に基づく修正対象です。', '元の図と修正後の分類を区別し、原図まで修正済みと言わない。', ARRAY['K079']::text[], ARRAY['P206']::text[], '{}', '[{"passage_id":"P206","chapter":8,"label":"8-1 睡眠とは何か","asset_id":"BM-CH08-A012","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH08-A012.png"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T14', '声はお腹から出るの？', 'お腹から直接声が出るという意味ではありません。教材では、呼気による声帯の振動を基本として、呼吸や体の支えが声を支えると説明しています。声には共鳴や発音なども関係します。', '声の質のすべてを呼吸だけで説明しない。', ARRAY['K054','K055']::text[], ARRAY['P069','P223','P070']::text[], '{}', '[{"passage_id":"P069","chapter":13,"label":"13-1 声の仕組み","asset_id":"BM-CH13-A002","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH13-A002.png"},{"passage_id":"P223","chapter":13,"label":"第13章導入","asset_id":"BM-CH13-A001","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH13-A001.png"},{"passage_id":"P070","chapter":13,"label":"13-2 声の支え","asset_id":"BM-CH13-A003","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH13-A003.jpeg"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T15', '第8章のやさしい4-7-8も7秒止めるの？', '第8章の「就寝前のやさしい呼吸」は保息なしの別手順です。名前だけを理由に7秒の息止めを付け足しません。保息の説明が曖昧な4-7-8呼吸のカードは、実践案内を保留しています。', '名称から保息を補完せず、別カードとして説明する。', ARRAY['C015','C007']::text[], ARRAY['P094','P24','P25','P26','P085']::text[], ARRAY['S002','S004']::text[], '[{"passage_id":"P094","chapter":8,"label":"8-9 やさしい版","asset_id":"BM-CH08-A002","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH08-A002.png"},{"passage_id":"P24","chapter":17,"label":"17-5 整理表の区分と教材での扱い","asset_id":"BM-CH17-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A005.png"},{"passage_id":"P25","chapter":17,"label":"17-5 現代呼吸法と他章接続の要約","asset_id":"BM-CH17-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A005.png"},{"passage_id":"P26","chapter":17,"label":"17-5 実践上の注意と選び方","asset_id":"BM-CH17-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A005.png"},{"passage_id":"P085","chapter":3,"label":"P19 4・7・8呼吸法","asset_id":"BM-CH03-A010","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH03-A010.png"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T16', '初心者だけどカパラバティは何回すればいい？', 'この教材では、初心者はカパラバティの特徴と注意点を学ぶ位置付けです。初心者向けの実践回数は案内しません。原稿の参考回数を、そのままあなたへの推奨回数にはしません。', '参考回数を初心者の推奨量に変換しない。', ARRAY['C005']::text[], ARRAY['P21','P22','P23','P24']::text[], ARRAY['S001','S004']::text[], '[{"passage_id":"P21","chapter":17,"label":"17-4 特徴・教材内での扱い","asset_id":"BM-CH17-A004","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A004.png"},{"passage_id":"P22","chapter":17,"label":"17-4 CYP記載として紹介される数値・禁忌","asset_id":"BM-CH17-A004","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A004.png"},{"passage_id":"P23","chapter":17,"label":"17-4 安全に行うための基本 第5部共通ルール","asset_id":"BM-CH17-A004","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A004.png"},{"passage_id":"P24","chapter":17,"label":"17-5 整理表の区分と教材での扱い","asset_id":"BM-CH17-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A005.png"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T17', 'ボックス呼吸は何セットに統一する？', '教材では第6章に4〜5サイクル、第7章に3〜5セットという違いがあります。別の章の数字を混ぜて統一せず、どの出典の手順かを明記します。保息を含むため、このDBでは個別の実践指示の自動配信を保留しています。', '出典差を明示。保管されている回数の比較と個別の実践指示を区別する。', ARRAY['C006']::text[], ARRAY['P24','P25','P26','P082','P083','P084','P187','P188','P186','P205']::text[], ARRAY['S002','S004']::text[], '[{"passage_id":"P24","chapter":17,"label":"17-5 整理表の区分と教材での扱い","asset_id":"BM-CH17-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A005.png"},{"passage_id":"P25","chapter":17,"label":"17-5 現代呼吸法と他章接続の要約","asset_id":"BM-CH17-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A005.png"},{"passage_id":"P26","chapter":17,"label":"17-5 実践上の注意と選び方","asset_id":"BM-CH17-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A005.png"},{"passage_id":"P082","chapter":6,"label":"6-10 実技6-2","asset_id":"BM-CH06-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH06-A005.png"},{"passage_id":"P083","chapter":7,"label":"7-10〜11","asset_id":"BM-CH07-A003","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH07-A003.png"},{"passage_id":"P084","chapter":7,"label":"7-11 やさしい版","asset_id":"BM-CH07-A003","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH07-A003.png"},{"passage_id":"P187","chapter":7,"label":"7-9〜7-11 ボックス呼吸","asset_id":"BM-CH07-A002","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH07-A002.png"},{"passage_id":"P188","chapter":7,"label":"7-12 本番前コントロール","asset_id":"BM-CH07-A004","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH07-A004.png"},{"passage_id":"P186","chapter":7,"label":"第7章導入","asset_id":"BM-CH07-A001","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH07-A001.jpeg"},{"passage_id":"P205","chapter":8,"label":"第2部 呼吸カルテ統合","asset_id":"BM-CH08-A011","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH08-A011.png"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T18', '1分間6呼吸なら5秒吸って5秒吐けばいい？', '回数だけから吸う・吐く時間の配分は決められません。この教材の一覧には「1分間6呼吸」と実施時間が載っていますが、吸気と呼気の比率や保息の有無は未記載です。5秒ずつという手順は補いません。', '未記載の秒数・保息を計算で推定しない。', ARRAY['C034']::text[], ARRAY['P205']::text[], ARRAY['S002','S004']::text[], '[{"passage_id":"P205","chapter":8,"label":"第2部 呼吸カルテ統合","asset_id":"BM-CH08-A011","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH08-A011.png"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T19', '食前の休息呼吸？ 食後の休息呼吸？', '第5版では「食後の休息呼吸」としています。元原稿の一部見出しは食前ですが、本文と第10章一覧の食後に合わせて整理しました。食前の整え呼吸とは分けて扱います。', '正式な編集後名称を使い、原図の見出しの違いも説明できる。', ARRAY['C026','K047']::text[], ARRAY['P105','P106','P120','P062']::text[], ARRAY['S004']::text[], '[{"passage_id":"P105","chapter":10,"label":"10-4 実践2（見出し表記差あり）","asset_id":"BM-CH10-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH10-A005.png"},{"passage_id":"P106","chapter":10,"label":"第10章 呼吸法整理","asset_id":"BM-CH10-A006","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH10-A006.png"},{"passage_id":"P120","chapter":11,"label":"第11章 正式名称と置換表","asset_id":"BM-CH11-A007","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH11-A007.png"},{"passage_id":"P062","chapter":10,"label":"10-4 食事と呼吸","asset_id":"BM-CH10-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH10-A005.png"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_acceptance_tests (test_id, question, answer_example, check_point, reference_entry_ids, source_passage_ids, safety_ids, source_links) VALUES ('T20', 'シータリーは引用先のCYPに必ず載っている？', '教材が引用するCYPの版では、掲載を確認できていないため、載っているとは断定しません。別の版を根拠にする場合は、版・ページを特定して照合する必要があります。', '教材のCYP準拠という記載を全技法の掲載証明にしない。', ARRAY['K019']::text[], ARRAY['P19','P24','P229']::text[], '{}', '[{"passage_id":"P19","chapter":17,"label":"17-3 シートカーリー補足","asset_id":"BM-CH17-A003","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A003.png"},{"passage_id":"P24","chapter":17,"label":"17-5 整理表の区分と教材での扱い","asset_id":"BM-CH17-A005","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH17-A005.png"},{"passage_id":"P229","chapter":15,"label":"第5部導入","asset_id":"BM-CH15-A001","path":"../YogaAI_回答用DB_全17章_v5/assets/BM-CH15-A001.jpeg"}]'::jsonb) ON CONFLICT (test_id) DO NOTHING;
