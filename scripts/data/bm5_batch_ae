INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K001', 'なぜ人は呼吸するのか', 'physiology', ARRAY['基礎','酸素','二酸化炭素']::text[], ARRAY['なぜ呼吸するの？','息をする目的は？']::text[], '呼吸は、体に必要な酸素を取り込み、体で生じた二酸化炭素を外に出す働きです。', '肺から血液、細胞へとつながる流れを学びます。酸素は、細胞が栄養からATPをつくる過程で使われます。酸素そのものがATPに変わるという意味ではありません。', ARRAY['P01','P03','P160']::text[], ARRAY['酸素そのものがATPに変わるとは説明しない。']::text[], ARRAY['EXT01','EXT03']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I001','I002']::text[], ARRAY[1,4]::integer[], ARRAY['I001','I002']::text[], '[{"issue_id":"I001","rule":"酸素は、細胞が栄養からATPをつくる過程で使われます。"},{"issue_id":"I002","rule":"「内呼吸」と「細胞呼吸」の用語欄を分け、それぞれの定義を監修後に掲載する。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K002', '呼吸の流れを4つに分けて理解する', 'physiology', ARRAY['全体像','換気','ガス交換','ATP']::text[], ARRAY['呼吸は肺だけの働き？']::text[], 'この教材では、空気の出入り、肺胞でのガス交換、血液による運搬、細胞でのエネルギー産生という流れで学びます。', '肺だけで完結するのではなく、血液循環や細胞の働きまでつなげて理解するための整理です。', ARRAY['P02']::text[], ARRAY['原図の「内呼吸＝Cellular Respiration」は用語確認待ち。回答では「細胞呼吸」と表現し、内呼吸と同義だと断定しない。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I002']::text[], ARRAY[1]::integer[], ARRAY['I002']::text[], '[{"issue_id":"I002","rule":"「内呼吸」と「細胞呼吸」の用語欄を分け、それぞれの定義を監修後に掲載する。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K003', '換気とは', 'physiology', ARRAY['肺','横隔膜','吸気','呼気']::text[], ARRAY['換気って何？','肺は自分で動くの？','肺は筋肉なの？','呼吸筋という筋肉が肺にあるの？']::text[], '換気は、空気を肺に出し入れすることです。', '肺は、自分で筋肉を縮めて空気を吸い込む器官ではありません。横隔膜や肋骨の間の筋肉が働いて胸の中の空間を広げると、それに伴って肺が膨らみ、空気が入ります。', ARRAY['P02','P03','P037','P151','P152','P154','P155']::text[], ARRAY['著者指定：肺自身が筋肉として収縮し吸気を起こすわけではないことを説明する。「呼吸筋」は肺にある固有の筋肉名として使わない。']::text[], ARRAY['EXT01']::text[], ARRAY['C007','C012','C013','C014']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I002','I017','I031','I032','I034']::text[], ARRAY[1,2,3]::integer[], ARRAY['I002','I017','I031','I032','I034']::text[], '[{"issue_id":"I002","rule":"「内呼吸」と「細胞呼吸」の用語欄を分け、それぞれの定義を監修後に掲載する。"},{"issue_id":"I017","rule":"ファイル上の章番号と図中の章番号を別に保存し、正式な章割りが決まった後に見出しを統一する。"},{"issue_id":"I031","rule":"一呼吸の周期と肺まで空気が移動する時間を区別する。「約0.5秒」「0.9秒」は定義・根拠確認まで掲載しない。"},{"issue_id":"I032","rule":"肺は、自分で筋肉を縮めて空気を吸い込む器官ではありません。横隔膜や肋骨の間の筋肉が働いて胸の中の空間を広げると、それに伴って肺が膨らみ、空気が入ります。"},{"issue_id":"I034","rule":"図に圧の測定部位・基準・単位・呼吸条件を明記する。確認前は「呼気時の胸腔内圧は陽圧」という一律の説明を外す。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K004', '肺胞で起こるガス交換', 'physiology', ARRAY['肺胞','外呼吸','毛細血管']::text[], ARRAY['肺胞は何をしているの？']::text[], '肺胞では、酸素が血液へ入り、二酸化炭素が血液から肺胞へ移ります。', '原稿が「外呼吸」と呼ぶ部分です。肺に空気を出し入れする換気と、その空気と血液の間でガスを交換する働きを区別して学びます。', ARRAY['P02','P03','P034','P156','P161']::text[], '{}', ARRAY['EXT01']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I002','I037']::text[], ARRAY[1,2,3,4]::integer[], ARRAY['I002','I037']::text[], '[{"issue_id":"I002","rule":"「内呼吸」と「細胞呼吸」の用語欄を分け、それぞれの定義を監修後に掲載する。"},{"issue_id":"I037","rule":"肺胞数は出典と条件が確認できた数値のみを記載する。確認前は「多数の肺胞」という説明にとどめる。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K005', '酸素はどうやって全身に届くのか', 'physiology', ARRAY['赤血球','ヘモグロビン','心臓']::text[], ARRAY['酸素は血液で運ばれる？']::text[], '取り込んだ酸素は主に赤血球のヘモグロビンと結び付き、血液の流れで全身へ運ばれます。', '心臓はその血液を送り出すポンプとして働きます。呼吸と循環を一緒に理解するための項目です。', ARRAY['P03','P039','P162','P163','P164']::text[], ARRAY['血管長や全細胞数を根拠未確認のまま付け足さない。']::text[], ARRAY['EXT01']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I002','I036','I037']::text[], ARRAY[1,4]::integer[], ARRAY['I002','I036','I037']::text[], '[{"issue_id":"I002","rule":"「内呼吸」と「細胞呼吸」の用語欄を分け、それぞれの定義を監修後に掲載する。"},{"issue_id":"I036","rule":"酸素タクシーは、結合部位を学ぶためのたとえです。必ず満席で出発し、全部を降ろすという意味ではありません。"},{"issue_id":"I037","rule":"肺胞数は出典と条件が確認できた数値のみを記載する。確認前は「多数の肺胞」という説明にとどめる。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K006', 'ATPとは', 'cell_energy', ARRAY['ATP','エネルギー','酸素']::text[], ARRAY['ATPって何？','酸素がATPになるの？']::text[], 'ATPは、細胞が活動に必要なエネルギーをやり取りするために使う分子です。', '酸素がそのままATPに変わるわけではありません。酸素は、栄養から得たエネルギーを使ってATPを作る過程を支えます。原稿の「エネルギー通貨」は、この役割を伝えるたとえです。', ARRAY['P01','P04','P043','P165','P168']::text[], ARRAY['「酸素がエネルギーに変わる」という原文は修正提案として別保存。']::text[], ARRAY['EXT03']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I001','I020','I038']::text[], ARRAY[1,4,5]::integer[], ARRAY['I001','I020','I038']::text[], '[{"issue_id":"I001","rule":"酸素は、細胞が栄養からATPをつくる過程で使われます。"},{"issue_id":"I020","rule":"ATPの再利用の説明を残し、「1日に体重の約100倍」の数値は根拠確認まで掲載しない。"},{"issue_id":"I038","rule":"細胞数とミトコンドリア数は分けて記載する。計算例として37兆×1.5µmを使うなら55,500km。ただし実際の総数・長さの説明としては未確定。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K007', 'ミトコンドリアの役割', 'cell_energy', ARRAY['細胞','ミトコンドリア','ATP']::text[], ARRAY['ミトコンドリアと呼吸はどう関係する？']::text[], 'ミトコンドリアは、多くの細胞でATPの産生を担う細胞内の構造です。', '原稿では「細胞の発電所」とたとえています。吸い込んだ酸素と細胞内の働きを結び付けて学ぶための説明です。', ARRAY['P07','P044','P167','P168','P170']::text[], ARRAY['すべての細胞にミトコンドリアがあるとは書かない。ATP産生量の数値と細胞数の換算は保留。']::text[], ARRAY['EXT03']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I003','I004','I005','I021','I038']::text[], ARRAY[1,5]::integer[], ARRAY['I003','I004','I005','I021','I038']::text[], '[{"issue_id":"I003","rule":"ATPの産生・利用は繰り返されています。原稿の「1分間に約2〜3kg」は根拠確認まで掲載しない。"},{"issue_id":"I004","rule":"多くの細胞では、ミトコンドリアがATPの産生に関わります。"},{"issue_id":"I005","rule":"37兆個（370,000億個）。※単位換算のみの修正案。37兆個という生物学的な数値の妥当性とは別。"},{"issue_id":"I021","rule":"糖からエネルギーを取り出す過程は複数あります。反応の場所と酸素の必要性を分けた図に描き直し、監修を受ける。"},{"issue_id":"I038","rule":"細胞数とミトコンドリア数は分けて記載する。計算例として37兆×1.5µmを使うなら55,500km。ただし実際の総数・長さの説明としては未確定。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K008', '二酸化炭素と呼吸調節', 'co2', ARRAY['CO₂','呼吸中枢']::text[], ARRAY['二酸化炭素は不要なもの？']::text[], '二酸化炭素は体外へ排出される一方、呼吸の調節にも関係しています。', '脳などが血液中の二酸化炭素や酸素に関する情報を受け取り、必要に応じて呼吸を調整します。二酸化炭素だけを唯一の呼吸スイッチと考えないことが大切です。', ARRAY['P05','P06','P049','P183']::text[], ARRAY['CO₂を意図的に増やす練習や息止めへ誘導しない。']::text[], ARRAY['EXT02']::text[], ARRAY['C006','C011']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I007','I043']::text[], ARRAY[1,6,7]::integer[], ARRAY['I007','I043']::text[], '[{"issue_id":"I007","rule":"CO₂は呼吸調節に関わります。「CO₂だけが呼吸を決める」「CO₂耐性がヨガの効果を確定する」という説明は削除候補にする。"},{"issue_id":"I043","rule":"引用欄に著者・資料名・発行年・個別URL・参照箇所を記載する。機関名だけの引用は根拠の確定に使わない。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K009', '二酸化炭素と血液のpH', 'co2', ARRAY['pH','酸塩基']::text[], ARRAY['二酸化炭素とpHは関係する？']::text[], '教材では、二酸化炭素の変化が血液の酸性・アルカリ性のバランスに関わると説明しています。', 'この項目は教材の生理学的説明です。自分の呼吸の感覚だけから血液のpHを推定したり、呼吸法でpHを調整しようとする指示には使いません。', ARRAY['P05']::text[], ARRAY['臨床的な酸塩基評価・治療への転用不可。外部検証は未実施。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I007']::text[], ARRAY[1]::integer[], ARRAY['I007']::text[], '[{"issue_id":"I007","rule":"CO₂は呼吸調節に関わります。「CO₂だけが呼吸を決める」「CO₂耐性がヨガの効果を確定する」という説明は削除候補にする。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K010', 'ボーア効果とは', 'co2', ARRAY['ボーア効果','ヘモグロビン','酸素']::text[], ARRAY['ボーア効果をやさしく説明して']::text[], '教材では、二酸化炭素が増えpHが低下する組織側で、ヘモグロビンが酸素を放しやすくなることをボーア効果として紹介しています。', '働いている組織への酸素の受け渡しを理解する項目です。「CO₂は多いほどよい」という意味には使いません。', ARRAY['P05']::text[], ARRAY['効果を理由に息止め・過剰なCO₂保持を勧めない。外部検証は未実施。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I007']::text[], ARRAY[1]::integer[], ARRAY['I007']::text[], '[{"issue_id":"I007","rule":"CO₂は呼吸調節に関わります。「CO₂だけが呼吸を決める」「CO₂耐性がヨガの効果を確定する」という説明は削除候補にする。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K011', '呼吸数を観察する', 'observation', ARRAY['セルフチェック','1分','記録']::text[], ARRAY['自分の呼吸を知るには？','呼吸数をどう数える？']::text[], '原稿では、安静にして、いつも通りの呼吸を1分間数える観察を紹介しています。', '回数と一緒に、そのときの体調や状況も記録しましょう。数値だけで良し悪しを判断せず、観察のための記録として扱います。', ARRAY['P08']::text[], ARRAY['原図の「8回以下はとても良い」を使用しない。呼吸数だけで健康状態や疾患を判定しない。']::text[], '{}', ARRAY['C001']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I006']::text[], ARRAY[1]::integer[], ARRAY['I006']::text[], '[{"issue_id":"I006","rule":"安静時の呼吸数を記録し、そのときの状態と一緒に振り返りましょう。回数だけで「良い・悪い」を採点しません。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K012', '胸やお腹の動きを観察する', 'observation', ARRAY['胸郭','腹部','肩','鼻呼吸']::text[], ARRAY['呼吸のどこを観察する？']::text[], '息の通り道、胸やお腹の動き、肩や首の力みなどを観察します。', '教材のチェック項目を、体の動きに気づくための観察として整理しました。「お腹が動かないから横隔膜が使えていない」などの診断には用いません。', ARRAY['P09','P157']::text[], ARRAY['原図の呼吸タイプ名は教材独自の分類として扱い、医学的診断名にしない。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I006']::text[], ARRAY[1,3]::integer[], ARRAY['I006']::text[], '[{"issue_id":"I006","rule":"安静時の呼吸数を記録し、そのときの状態と一緒に振り返りましょう。回数だけで「良い・悪い」を採点しません。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K013', '呼吸カルテに記録すること', 'observation', ARRAY['カルテ','朝昼夜','気分']::text[], ARRAY['呼吸記録には何を書けばいい？']::text[], '呼吸数、鼻や口の呼吸、呼吸の感覚と、その日の睡眠・疲労感・気分などを記録します。', '第1章の呼吸カルテと第5部のワークを別の様式として保存しています。記録は変化に気づく材料であり、記録だけで病気や原因を決めるものではありません。', ARRAY['P10','P27','P176','P190','P201','P205','P222']::text[], ARRAY['宣伝文の「AIが最適な改善提案」を実装済み機能として案内しない。']::text[], '{}', ARRAY['C001','C002','C003','C004','C005','C006','C007','C008','C009','C010']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I013']::text[], ARRAY[1,6,7,8,12,17]::integer[], ARRAY['I013']::text[], '[{"issue_id":"I013","rule":"この教材では、睡眠・集中などに関連する学習テーマとして呼吸を紹介します。個人の改善を保証する表現は削る。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K014', 'プラーナとは', 'yoga_theory', ARRAY['伝統的概念','プラーナ']::text[], ARRAY['プラーナは酸素のこと？']::text[], 'プラーナは、ヨガで生命エネルギーを表すために使われる伝統的な考え方です。', '教材では呼吸を通して心と体を整える文脈で扱っています。酸素やATPと同じ物質・測定値としては登録していません。', ARRAY['P15']::text[], ARRAY['プラーナ＝酸素、ATP、神経活動という同一視をしない。']::text[], '{}', ARRAY['C001','C002','C003','C004','C005','C006','C007','C008','C009','C010']::text[], 'editorial_draft', 'traditional_explanation', true, false, false, ARRAY['I008','I009']::text[], ARRAY[17]::integer[], ARRAY['I008','I009']::text[], '[{"issue_id":"I008","rule":"引用するCYPの版・発行年・ページを明記する。シータリーの掲載を確認できるまでは「このCYPに明記」と書かない。"},{"issue_id":"I009","rule":"簡易版の本文に合わせ、耳を塞ぐ動作は手順に追加しない。イラストも本文と一致させる。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
