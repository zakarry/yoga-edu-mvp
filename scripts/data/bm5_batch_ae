INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K023', '気管と気管支', 'physiology', ARRAY['気管','気管支','線毛']::text[], ARRAY['気管と気管支とは？']::text[], '気管から左右の肺へ分かれる気管支は、さらに枝分かれして肺の中へ空気を届けます。', '教材は粘液や線毛も紹介しています。構造の説明として扱います。', ARRAY['P033']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, '{}', ARRAY[2]::integer[], '{}', '[]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K024', '肺胞とサーファクタント', 'physiology', ARRAY['肺胞','サーファクタント']::text[], ARRAY['肺胞とサーファクタントとは？']::text[], '教材ではサーファクタントを、肺胞がつぶれにくくなるよう助けるものとして紹介しています。', '肺胞の構造と働きの学習用です。', ARRAY['P035']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, '{}', ARRAY[2]::integer[], '{}', '[]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K025', '胸郭とは', 'physiology', ARRAY['胸郭','肋骨','肋間筋']::text[], ARRAY['胸郭とはとは？']::text[], '胸郭は、肋骨・胸骨・背骨で構成される胸のかご状の構造です。', '胸郭の動きと呼吸を結び付けて学びます。安静時と力を入れて吐く場合の筋活動は区別します。', ARRAY['P036','P153']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I016','I033']::text[], ARRAY[2,3]::integer[], ARRAY['I016','I033']::text[], '[{"issue_id":"I016","rule":"安静時に吐く場合と、力を入れて吐く場合を分けて説明する。筋肉名と図の動作は監修後に確定する。"},{"issue_id":"I033","rule":"肋骨の動きの名称・方向・胸骨との接続先を監修し、図と本文を同時に修正する。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K026', '横隔膜とは', 'physiology', ARRAY['横隔膜','吸気','呼気']::text[], ARRAY['横隔膜とはとは？']::text[], '横隔膜は胸とお腹を隔てるドーム状の筋肉です。吸うときに収縮して下がり、胸の空間を広げます。', '横隔膜や肋骨の間の筋肉が胸の中の空間を動かすことで、肺が膨らみます。肺自身が筋肉として縮んで空気を吸い込むという意味ではありません。安静時に吐くときは横隔膜がゆるみます。', ARRAY['P037','P150']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', ARRAY['C012','C013','C014']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I017']::text[], ARRAY[2,3]::integer[], ARRAY['I017']::text[], '[{"issue_id":"I017","rule":"ファイル上の章番号と図中の章番号を別に保存し、正式な章割りが決まった後に見出しを統一する。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K027', '死腔と肺胞換気', 'physiology', ARRAY['死腔','肺胞換気','1回換気量']::text[], ARRAY['死腔と肺胞換気とは？']::text[], '吸った空気のすべてがガス交換に使われるわけではありません。教材はガス交換に直接参加しない空気の通り道を死腔として説明しています。', '1回の量と回数の両方が肺胞に届く空気量に関係します。原図の500mL・1000mLなどは比較例であり、深く吸う練習の目標値にはしません。', ARRAY['P038']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', ARRAY['C012','C013','C014']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I017','I018']::text[], ARRAY[3]::integer[], ARRAY['I017','I018']::text[], '[{"issue_id":"I017","rule":"ファイル上の章番号と図中の章番号を別に保存し、正式な章割りが決まった後に見出しを統一する。"},{"issue_id":"I018","rule":"この図は、死腔と肺胞換気を理解するための計算例です。呼吸を大きくする練習の目標値ではありません。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K028', '肺循環と体循環', 'physiology', ARRAY['心臓','肺循環','体循環']::text[], ARRAY['肺循環と体循環とは？']::text[], '肺循環は心臓と肺を結ぶ流れ、体循環は心臓と全身を結ぶ流れです。', '教材は心臓を酸素の運搬を支えるポンプとして説明しています。', ARRAY['P040','P160','P164']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I037']::text[], ARRAY[4]::integer[], ARRAY['I037']::text[], '[{"issue_id":"I037","rule":"肺胞数は出典と条件が確認できた数値のみを記載する。確認前は「多数の肺胞」という説明にとどめる。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K029', 'SpO₂の読み方', 'observation', ARRAY['SpO₂','酸素飽和度','パルスオキシメータ']::text[], ARRAY['SpO₂の読み方とは？']::text[], 'SpO₂は、血液中のヘモグロビンと酸素の結び付きの割合を推定する指標です。', '測定には誤差や限界があります。値だけで健康・不調を判定せず、症状や測定条件も含めて扱います。', ARRAY['P041','P158']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], ARRAY['EXT05']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I019','I035']::text[], ARRAY[4]::integer[], ARRAY['I019','I035']::text[], '[{"issue_id":"I019","rule":"SpO₂の数値だけで健康状態を採点しません。測定条件や症状も含めて扱います。"},{"issue_id":"I035","rule":"章内のSpO₂区分表は回答用から外し、統一する医学的な基準・対象・条件を監修者に確認する。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K030', 'ミトコンドリアの構造', 'cell_energy', ARRAY['ミトコンドリア','内膜','クリステ','マトリックス']::text[], ARRAY['ミトコンドリアの構造とは？']::text[], '教材では外膜・内膜・クリステ・マトリックスを紹介しています。クリステは内膜のひだです。', 'ATPの説明は共通知識に統合しています。', ARRAY['P042']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, '{}', ARRAY[5]::integer[], '{}', '[]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K031', '活性酸素の教材内での位置付け', 'cell_energy', ARRAY['活性酸素','酸化ストレス']::text[], ARRAY['活性酸素の教材内での位置付けとは？']::text[], '教材は、活性酸素を単に悪いものとせず、情報伝達や防御にも関係するものとして説明しています。', '過剰な状態の説明と通常の働きを分けます。呼吸法や食品で老化を防ぐという保証には使いません。', ARRAY['P045']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, '{}', ARRAY[5]::integer[], '{}', '[]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K032', '交感神経と副交感神経', 'mind', ARRAY['自律神経','交感神経','副交感神経']::text[], ARRAY['交感神経と副交感神経とは？']::text[], '交感神経と副交感神経は、どちらも命を支える働きを持ちます。', '教材は必要なときに状態を切り替えることを大切にしています。交感神経は悪い、副交感神経は常によい、とは扱いません。', ARRAY['P046','P173','P180','P181']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', ARRAY['C034']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I041']::text[], ARRAY[6]::integer[], ARRAY['I041']::text[], '[{"issue_id":"I041","rule":"呼吸と自律神経の関係を学びます。吸気・呼気を全身の神経状態が完全に切り替わるスイッチとして説明しません。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K033', 'HRVとは', 'observation', ARRAY['HRV','心拍変動','R-R間隔']::text[], ARRAY['HRVとはとは？']::text[], '心拍変動（HRV）は心臓の拍動の間隔が少しずつ変化することです。', '教材でも、高ければ必ず健康、低ければ必ず不調とは判断しないとしています。呼吸・姿勢・活動・睡眠などの状況と一緒に扱います。', ARRAY['P047','P178','P185']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', ARRAY['C034']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I041','I042']::text[], ARRAY[6]::integer[], ARRAY['I041','I042']::text[], '[{"issue_id":"I041","rule":"呼吸と自律神経の関係を学びます。吸気・呼気を全身の神経状態が完全に切り替わるスイッチとして説明しません。"},{"issue_id":"I042","rule":"「心拍数」と「R-R間隔」を別の量として表示する。軸名・単位・波形の向きを確認して図を差し替える。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K034', '長い呼気の考え方', 'mind', ARRAY['長い呼気','休息']::text[], ARRAY['長い呼気の考え方とは？']::text[], '教材では吸う息より吐く息を長くする練習を紹介しています。', '苦しくなるまで長く吐く練習にはしません。秒数・回数は呼吸法カードに章ごとに保存しています。', ARRAY['P048','P175','P184']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', ARRAY['C008','C034']::text[], 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I022','I041','I043']::text[], ARRAY[6]::integer[], ARRAY['I022','I041','I043']::text[], '[{"issue_id":"I022","rule":"基本手順と図中の「自然な間」を別記する。記載のない固定保息や毎分回数へ換算しない。"},{"issue_id":"I041","rule":"呼吸と自律神経の関係を学びます。吸気・呼気を全身の神経状態が完全に切り替わるスイッチとして説明しません。"},{"issue_id":"I043","rule":"引用欄に著者・資料名・発行年・個別URL・参照箇所を記載する。機関名だけの引用は根拠の確定に使わない。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K035', '自動の呼吸と意識的な呼吸', 'mind', ARRAY['延髄','橋','呼吸中枢']::text[], ARRAY['自動の呼吸と意識的な呼吸とは？']::text[], '教材は、延髄や橋などによる自動調整と、意識して呼吸を変える働きを説明しています。', '呼吸は自動調整と意識的調整が交わる働きとして学びます。', ARRAY['P049','P193']::text[], ARRAY['原図の主要箇所を目視確認した要約。効能・個別適用の審査とは別。']::text[], '{}', ARRAY['C011']::text[], 'editorial_draft', 'educational_explanation', true, false, false, '{}', ARRAY[7]::integer[], '{}', '[]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
