INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K079', 'NREM睡眠とREM睡眠', 'sleep', ARRAY['NREM','REM','ノンレム','レム','睡眠段階']::text[], ARRAY['NREM睡眠とREM睡眠とは？']::text[], '睡眠の分類として、NREM睡眠とREM睡眠を学びます。', 'NREM睡眠はN1・N2・N3の3段階として整理します。原図の4段階表示は、保存済みのNHLBI資料との照合に基づく修正対象です。周期を固定した睡眠タイマーには使いません。', ARRAY['P206']::text[], ARRAY['原図の目視確認に基づく編集要約。原文引用ではない。']::text[], ARRAY['EXT08']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I046']::text[], ARRAY[8]::integer[], ARRAY['I046']::text[], '[{"issue_id":"I046","rule":"NREM睡眠をN1・N2・N3の3段階に整理する。図の配置と本文をまとめて更新する。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K080', '睡眠中の呼吸の特徴', 'sleep', ARRAY['睡眠','自動調整','呼吸リズム']::text[], ARRAY['睡眠中の呼吸の特徴とは？']::text[], '教材では、眠っている間の呼吸は主に自動調整され、睡眠段階や筋肉の状態にも影響されると説明しています。', '睡眠中は誰でも同じ深さ・同じ間隔で呼吸するという意味ではありません。いびきや呼吸停止の指摘は別に記録して扱います。', ARRAY['P207']::text[], ARRAY['原図の目視確認に基づく編集要約。原文引用ではない。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I043']::text[], ARRAY[8]::integer[], ARRAY['I043']::text[], '[{"issue_id":"I043","rule":"引用欄に著者・資料名・発行年・個別URL・参照箇所を記載する。機関名だけの引用は根拠の確定に使わない。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K081', 'いびきと睡眠時無呼吸を区別する', 'sleep', ARRAY['いびき','SAS','睡眠時無呼吸']::text[], ARRAY['いびきと睡眠時無呼吸を区別するとは？']::text[], '教材は、いびきを空気の通り道が狭くなり、周囲の組織が振動して出る音として説明しています。', 'いびきだけで睡眠時無呼吸と診断しません。呼吸停止の指摘や強い日中の眠気などは相談につなぐ別項目と組み合わせます。', ARRAY['P210']::text[], ARRAY['原図の目視確認に基づく編集要約。原文引用ではない。']::text[], ARRAY['EXT07']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, '{}', ARRAY[8]::integer[], '{}', '[]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K082', '鼻呼吸がしにくい場合の教材方針', 'safety', ARRAY['鼻づまり','口呼吸','口閉じテープ']::text[], ARRAY['鼻呼吸がしにくい場合の教材方針とは？']::text[], '教材は鼻づまりなどで鼻呼吸が難しい場合に、鼻呼吸だけを強制しないとしています。', '自己判断で口閉じテープをすすめる手順は作りません。鼻の通りやいびきなどを確認し、必要な相談につなぐという原稿の方針を保存しています。', ARRAY['P208','P209','P196']::text[], ARRAY['原図の目視確認に基づく編集要約。原文引用ではない。']::text[], '{}', '{}', 'editorial_draft', 'educational_explanation', true, false, false, ARRAY['I047']::text[], ARRAY[7,8]::integer[], ARRAY['I047']::text[], '[{"issue_id":"I047","rule":"鼻の構造・NOの説明と、脳・免疫・いびき・睡眠への効果の主張を別に扱う。効能の矢印は根拠確認まで保留する。"}]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
INSERT INTO breath_manager_v5.bm5_knowledge (knowledge_id, title, category_id, tags, example_questions, answer_short, answer_detail, source_passage_ids, editorial_notes, external_check_ids, related_catalog_ids, review_state, content_kind, preview_allowed, production_ready, clinical_efficacy_verified, issue_ids, chapter_numbers, editorial_correction_ids, answer_constraints, editorial_policy_version) VALUES ('K083', '眠りの準備と生活習慣', 'sleep', ARRAY['睡眠習慣','就寝準備','光','生活リズム']::text[], ARRAY['眠りの準備と生活習慣とは？']::text[], '教材は、呼吸法とともに寝起きの時刻、寝室、光、電子機器、食事などの生活を振り返ります。', '呼吸法だけで睡眠を解決するという説明にはしません。記録を続け、気になる状態が続くときの相談とは分けて扱います。', ARRAY['P200','P212']::text[], ARRAY['原図の目視確認に基づく編集要約。原文引用ではない。']::text[], ARRAY['EXT09']::text[], '{}', 'editorial_draft', 'educational_explanation', true, false, false, '{}', ARRAY[8]::integer[], '{}', '[]'::jsonb, '5.0') ON CONFLICT (knowledge_id) DO NOTHING;
